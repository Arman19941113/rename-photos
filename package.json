{
  "name": "rename-photos",
  "private": true,
  "description": "A cross-platform desktop-app for renaming photos using EXIF data",
  "keywords": [
    "cross-platform",
    "desktop-app",
    "rename photos",
    "rename files"
  ],
  "license": "MIT",
  "author": "Arman Tang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arman19941113/rename-photos"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build": "tsc && vite build",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "tauri icon assets/icon/app-icon.svg"
  },
  "dependencies": {
    "@heroui/button": "^2.2.32",
    "@heroui/dropdown": "^2.3.32",
    "@heroui/input": "^2.4.33",
    "@heroui/modal": "^2.2.29",
    "@heroui/radio": "^2.3.32",
    "@heroui/scroll-shadow": "^2.3.19",
    "@heroui/snippet": "^2.2.33",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "^2.4.28",
    "@heroui/table": "^2.2.32",
    "@heroui/tabs": "^2.2.29",
    "@heroui/theme": "^2.4.26",
    "@heroui/tooltip": "^2.2.29",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "i18next": "^26.7.1",
    "mime": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-toastify": "^11.2.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^11.6.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x",
      "onFail": "error"
    }
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 128",
    "Safari >= 16.4"
  ]
}
